<?xml version="1.0" encoding="UTF-8"?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml" styleClass="form" spacing="8" fx:controller="com.estateflow.controller.VendorFormController">
 <Label styleClass="page-title" text="Vendor details"/><Label text="Keep contact information current; inactive vendors remain available on historical work orders." wrapText="true"/>
 <Label text="Name"/><TextField fx:id="name" promptText="Company or contact name"/><Label text="Service category"/><ComboBox fx:id="category" maxWidth="Infinity"/>
 <Label text="Phone"/><TextField fx:id="phone"/><Label text="Email"/><TextField fx:id="email"/><Label text="Address"/><TextField fx:id="address"/><Label text="Notes"/><TextArea fx:id="notes" prefRowCount="3"/><CheckBox fx:id="active" text="Active"/>
 <HBox spacing="8" alignment="CENTER_RIGHT"><Button text="Cancel" onAction="#onCancel"/><Button fx:id="saveButton" styleClass="btn-primary" text="Save vendor" onAction="#onSave"/></HBox>
</VBox>
