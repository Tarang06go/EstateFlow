<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<GridPane xmlns:fx="http://javafx.com/fxml" styleClass="form" fx:controller="com.estateflow.controller.DepositFormController">
  <Label fx:id="infoLabel" wrapText="true" maxWidth="420" GridPane.rowIndex="0" GridPane.columnSpan="2"/>
  <Label text="Amount *" GridPane.rowIndex="1"/><TextField fx:id="amountField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
  <Label text="Date *" GridPane.rowIndex="2"/><DatePicker fx:id="datePicker" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
  <Label fx:id="methodLabel" text="Payment method *" GridPane.rowIndex="3"/><ComboBox fx:id="methodBox" prefWidth="200" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
  <Label fx:id="reasonLabel" text="Reason *" GridPane.rowIndex="4"/><TextField fx:id="reasonField" prefWidth="300" promptText="e.g. Wall repainting" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
  <Label fx:id="referenceLabel" text="Reference no." GridPane.rowIndex="5"/><TextField fx:id="referenceField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
  <Label text="Notes" GridPane.rowIndex="6"/><TextArea fx:id="notesArea" prefRowCount="2" wrapText="true" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
  <HBox spacing="8" GridPane.rowIndex="7" GridPane.columnIndex="1">
    <Button fx:id="saveButton" styleClass="btn-primary" text="Save" onAction="#onSave" defaultButton="true"/>
    <Button text="Cancel" onAction="#onCancel" cancelButton="true"/></HBox>
</GridPane>
