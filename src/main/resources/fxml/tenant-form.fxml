<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<GridPane xmlns:fx="http://javafx.com/fxml" styleClass="form" fx:controller="com.estateflow.controller.TenantFormController">
  <Label text="Full name *" GridPane.rowIndex="0"/><TextField fx:id="nameField" prefWidth="300" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
  <Label text="Phone *" GridPane.rowIndex="1"/><TextField fx:id="phoneField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
  <Label text="Email" GridPane.rowIndex="2"/><TextField fx:id="emailField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
  <Label text="Address" GridPane.rowIndex="3"/><TextField fx:id="addressField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
  <Label text="ID proof type" GridPane.rowIndex="4"/><ComboBox fx:id="idTypeBox" editable="true" prefWidth="300" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
  <Label text="ID proof number" GridPane.rowIndex="5"/><TextField fx:id="idNumberField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
  <Label text="Emergency contact" GridPane.rowIndex="6"/><TextField fx:id="emergencyNameField" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
  <Label text="Emergency phone" GridPane.rowIndex="7"/><TextField fx:id="emergencyPhoneField" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
  <Label styleClass="hint" text="ID proof type and number must be given together." GridPane.rowIndex="8" GridPane.columnIndex="1"/>
  <HBox spacing="8" GridPane.rowIndex="9" GridPane.columnIndex="1">
    <Button fx:id="saveButton" styleClass="btn-primary" text="Save" onAction="#onSave" defaultButton="true"/>
    <Button text="Cancel" onAction="#onCancel" cancelButton="true"/></HBox>
</GridPane>
