<?xml version="1.0" encoding="UTF-8"?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml" styleClass="form" spacing="8" fx:controller="com.estateflow.controller.InspectionFormController">
 <Label styleClass="page-title" text="New property inspection"/><Label text="A first finding is required. Add a follow-up to create a regular maintenance request." wrapText="true"/>
 <Label text="Property"/><ComboBox fx:id="propertyBox" maxWidth="Infinity"/><Label text="Inspection type"/><ComboBox fx:id="typeBox" maxWidth="Infinity"/><Label text="Inspection date"/><DatePicker fx:id="datePicker"/><Label text="Summary"/><TextArea fx:id="summaryArea" prefRowCount="2" promptText="Optional overall condition"/>
 <Label styleClass="section-title" text="Checklist finding"/><Label text="Area"/><TextField fx:id="areaField" promptText="Kitchen, roof, plumbing…"/><Label text="Condition"/><ComboBox fx:id="conditionBox" maxWidth="Infinity"/><Label text="Observation"/><TextArea fx:id="observationArea" prefRowCount="3"/><Label text="Follow-up action"/><TextArea fx:id="followUpArea" prefRowCount="2" promptText="Optional action"/>
 <HBox spacing="8" alignment="CENTER_RIGHT"><Button text="Cancel" onAction="#onCancel"/><Button fx:id="saveButton" styleClass="btn-primary" text="Save draft" onAction="#onSave"/></HBox>
</VBox>
