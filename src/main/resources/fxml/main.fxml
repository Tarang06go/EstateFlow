<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.estateflow.controller.MainController">
  <left>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #1f2d3d; -fx-background: #1f2d3d;">
      <VBox styleClass="sidebar">
        <Label styleClass="sidebar-title" text="EstateFlow"/>
        <Label styleClass="sidebar-subtitle" text="Property &amp; rental management"/>
        <TextField fx:id="globalSearch" styleClass="sidebar-search" promptText="Search everything..." onAction="#onGlobalSearch"/>
        <Label styleClass="sidebar-section" text="OVERVIEW"/>
        <Button styleClass="nav-button" text="Dashboard" onAction="#showDashboard"/>
        <Button styleClass="nav-button" text="Rent Reminders" onAction="#showReminders"/>
        <Label styleClass="sidebar-section" text="PEOPLE &amp; PROPERTY"/>
        <Button styleClass="nav-button" text="Owners" onAction="#showOwners"/>
        <Button styleClass="nav-button" text="Tenants" onAction="#showTenants"/>
        <Button styleClass="nav-button" text="Properties" onAction="#showProperties"/>
        <Label styleClass="sidebar-section" text="RENT"/>
        <Button styleClass="nav-button" text="Agreements" onAction="#showAgreements"/>
        <Button styleClass="nav-button" text="Rent &amp; Payments" onAction="#showLedger"/>
        <Button styleClass="nav-button" text="Payments" onAction="#showPayments"/>
        <Button styleClass="nav-button" text="Overdue Rent" onAction="#showOverdue"/>
        <Button styleClass="nav-button" text="Expiring Leases" onAction="#showExpiring"/>
        <Label styleClass="sidebar-section" text="OPERATIONS"/>
        <Button styleClass="nav-button" text="Maintenance" onAction="#showMaintenance"/>
        <Button styleClass="nav-button" text="Reports" onAction="#showReports"/>
        <Button styleClass="nav-button" text="Audit History" onAction="#showAudit"/>
      </VBox>
    </ScrollPane>
  </left>
  <center><StackPane fx:id="content"/></center>
</BorderPane>
