<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.estateflow.controller.MainController">
  <left>
    <VBox styleClass="sidebar">
      <StackPane fx:id="brandHolder" styleClass="sidebar-brand" alignment="CENTER_LEFT"/>
      <VBox style="-fx-padding: 0 14 6 14;"><TextField fx:id="globalSearch" styleClass="sidebar-search" promptText="Search everything..." onAction="#onGlobalSearch"/></VBox>
      <ScrollPane styleClass="sidebar-scroll" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
        <VBox fx:id="navBox" style="-fx-padding: 0 14 8 14;"/>
      </ScrollPane>
      <VBox styleClass="sidebar-user" spacing="2">
        <Label fx:id="userLabel" styleClass="sidebar-user-name"/>
        <Label fx:id="roleLabel" styleClass="sidebar-user-role"/>
        <Button fx:id="logoutButton" styleClass="sidebar-logout" text="Sign out" maxWidth="Infinity" onAction="#onLogout"/>
      </VBox>
      <Label fx:id="versionLabel" styleClass="sidebar-footer"/>
    </VBox>
  </left>
  <center>
    <VBox minHeight="0">
      <ProgressBar fx:id="busyBar" styleClass="busy-bar" maxWidth="Infinity" progress="-1" visible="false"/>
      <StackPane VBox.vgrow="ALWAYS" minHeight="0">
        <ScrollPane fx:id="contentScroll" styleClass="main-content-scroll" minHeight="0"
                    fitToWidth="true" fitToHeight="false"
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"/>
        <StackPane fx:id="assistantLayer" alignment="BOTTOM_RIGHT" pickOnBounds="false"/>
        <VBox fx:id="toastBox" alignment="BOTTOM_RIGHT" spacing="8" pickOnBounds="false" mouseTransparent="true" style="-fx-padding: 0 24 24 0;"/>
      </StackPane>
    </VBox>
  </center>
</BorderPane>
