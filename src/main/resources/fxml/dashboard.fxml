<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns:fx="http://javafx.com/fxml" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #F6F7F4;"
            fx:controller="com.estateflow.controller.DashboardController">
  <VBox styleClass="page">
    <HBox alignment="CENTER_LEFT" spacing="12">
      <VBox styleClass="page-header"><Label styleClass="page-title" text="Dashboard"/><Label fx:id="subtitleLabel" styleClass="page-subtitle"/></VBox>
      <Region HBox.hgrow="ALWAYS"/>
      <Label styleClass="caption" text="Period"/><ComboBox fx:id="periodBox" prefWidth="150"/>
      <Button fx:id="refreshButton" text="Refresh" onAction="#refresh"/>
    </HBox>
    <HBox fx:id="quickActions" spacing="8"/>
    <HBox fx:id="kpiRow" spacing="14"/>
    <VBox fx:id="portfolioStrip" styleClass="card"/>
    <HBox spacing="14" alignment="TOP_LEFT">
      <VBox fx:id="financeCard" styleClass="card" HBox.hgrow="ALWAYS" prefWidth="620"/>
      <VBox fx:id="occupancyCard" styleClass="card" prefWidth="330" minWidth="300"/>
    </HBox>
    <Label styleClass="section-title" text="Action required"/>
    <GridPane fx:id="actionGrid" hgap="14" vgap="14"/>
    <HBox spacing="14" alignment="TOP_LEFT">
      <VBox fx:id="activityCard" styleClass="card" HBox.hgrow="ALWAYS" prefWidth="400"/>
      <VBox fx:id="maintenanceCard" styleClass="card" HBox.hgrow="ALWAYS" prefWidth="540"/>
    </HBox>
  </VBox>
</ScrollPane>
